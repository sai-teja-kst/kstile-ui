{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "kstile",
  "homepage": "https://kstile-ui.vercel.app",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "kstile theme",
      "description": "Square corners, Open Sans and the default lime accent.",
      "files": [],
      "cssVars": {
        "theme": {
          "font-sans": "'Open Sans', system-ui, sans-serif"
        },
        "light": {
          "radius": "0rem",
          "primary": "#b4e600",
          "primary-foreground": "#000"
        },
        "dark": {
          "primary": "#b4e600",
          "primary-foreground": "#000"
        }
      }
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "A square button with a thick border, in six variants.",
      "dependencies": ["@radix-ui/react-slot", "class-variance-authority"],
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "react/button.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "tile",
      "type": "registry:ui",
      "title": "Tile",
      "description": "A square, flat block for content or links, in a grid of four sizes, with an optional flip.",
      "dependencies": ["@radix-ui/react-slot", "class-variance-authority"],
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "react/tile.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "accent-picker",
      "type": "registry:ui",
      "title": "Accent picker",
      "description": "A square in the current accent that opens a row of 8 accent swatches.",
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "react/accent-picker.tsx",
          "type": "registry:ui"
        }
      ],
      "css": {
        ":root[data-accent=\"lime\"], [data-accent=\"lime\"]": {
          "--primary": "#b4e600",
          "--primary-foreground": "#000"
        },
        ":root[data-accent=\"mono\"], [data-accent=\"mono\"]": {
          "--primary": "#000",
          "--primary-foreground": "#fff"
        },
        ":root.dark[data-accent=\"mono\"], .dark [data-accent=\"mono\"]": {
          "--primary": "#fff",
          "--primary-foreground": "#000"
        },
        ":root[data-accent=\"teal\"], [data-accent=\"teal\"]": {
          "--primary": "#00b8b0",
          "--primary-foreground": "#000"
        },
        ":root[data-accent=\"blue\"], [data-accent=\"blue\"]": {
          "--primary": "#2f8cff",
          "--primary-foreground": "#000"
        },
        ":root[data-accent=\"magenta\"], [data-accent=\"magenta\"]": {
          "--primary": "#ee2f96",
          "--primary-foreground": "#000"
        },
        ":root[data-accent=\"red\"], [data-accent=\"red\"]": {
          "--primary": "#f4473f",
          "--primary-foreground": "#000"
        },
        ":root[data-accent=\"orange\"], [data-accent=\"orange\"]": {
          "--primary": "#ff7a1a",
          "--primary-foreground": "#000"
        },
        ":root[data-accent=\"yellow\"], [data-accent=\"yellow\"]": {
          "--primary": "#ffd21f",
          "--primary-foreground": "#000"
        }
      }
    },
    {
      "name": "dropdown-menu",
      "type": "registry:ui",
      "title": "Dropdown menu",
      "description": "A square, flat menu of actions or options, opened from a button or a tile.",
      "dependencies": ["@radix-ui/react-dropdown-menu", "@radix-ui/react-slot"],
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "react/dropdown-menu.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "input",
      "type": "registry:ui",
      "title": "Input",
      "description": "A square text field with a thick border, or a tile with its label inside.",
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "react/input.tsx",
          "type": "registry:ui"
        }
      ]
    }
  ]
}
